#!/usr/bin/perl

=head1 NAME

munin-migrate-rrd - Offline tool to merge/split RRD files

=head1 SYNOPSIS

munin-migrate-rrd [options] -i input -o output [-i input -o output ...]

Options:
  --dbdir=PATH     Base directory for RRD files (default: /var/lib/munin)
  --merge          Merge single-DS files into multi-DS
  --split          Split multi-DS into single-DS files
  --dry-run        Show what would be done without doing it
  --verbose        Show detailed progress
  --help           Show this help

Input/Output format:
  -i file.rrd:field   Input file with DS name
  -o file.rrd:field   Output file with DS name

=head1 EXAMPLES

  # Merge three single-DS files into one multi-DS
  munin-migrate-rrd --merge \
    -i cpu-idle-g.rrd:42 -o cpu-g.rrd:idle-g \
    -i cpu-user-g.rrd:42 -o cpu-g.rrd:user-g \
    -i cpu-system-g.rrd:42 -o cpu-g.rrd:system-g

  # Split multi-DS into single-DS
  munin-migrate-rrd --split \
    -i cpu-g.rrd:idle-g -o cpu-idle-g.rrd:42 \
    -i cpu-g.rrd:user-g -o cpu-user-g.rrd:42 \
    -i cpu-g.rrd:system-g -o cpu-system-g.rrd:42

=cut

use strict;
use warnings;
use Getopt::Long;
use File::Spec;
use File::Basename qw(dirname basename);
use File::Path qw(make_path);
use File::Temp qw(tempfile tempdir);
use RRDs;
use Pod::Usage;

# Parse options
my $dbdir = '/var/lib/munin';
my $merge = 0;
my $split = 0;
my $dry_run = 0;
my $verbose = 0;
my $help = 0;

my @input_args;
my @output_args;

GetOptions(
    'dbdir=s'    => \$dbdir,
    'merge'      => \$merge,
    'split'      => \$split,
    'dry-run'    => \$dry_run,
    'verbose'    => \$verbose,
    'help'       => \$help,
    'i=s'        => \@input_args,
    'o=s'        => \@output_args,
) or pod2usage(1);

pod2usage(0) if $help;

# Validate options
die "Error: Must specify --merge or --split\n" unless $merge || $split;
die "Error: Cannot specify both --merge and --split\n" if $merge && $split;
die "Error: No input files specified\n" unless @input_args;
die "Error: No output files specified\n" unless @output_args;

# Expand comma-separated specs
# -i file1:ds1,file2:ds2 → two specs
# -o file:ds1,ds2 → same file, two specs (file:ds1 + file:ds2)
sub expand_specs {
    my ($is_input, @specs) = @_;
    my @expanded;
    for my $spec (@specs) {
        if ($spec =~ /,/) {
            my @parts = split(/,/, $spec);
            # For outputs, if first part has file:field, subsequent parts inherit file
            if (!$is_input && @parts > 1 && $parts[0] =~ /^([^:]+):(.+)$/) {
                my $file = $1;
                for my $part (@parts) {
                    if ($part =~ /:/) {
                        push @expanded, $part;
                    } else {
                        push @expanded, "$file:$part";
                    }
                }
            } else {
                push @expanded, @parts;
            }
        } else {
            push @expanded, $spec;
        }
    }
    return @expanded;
}

my @input_specs_raw = expand_specs(1, @input_args);
my @output_specs_raw = expand_specs(0, @output_args);

die "Error: Number of inputs must equal outputs\n"
    unless @input_specs_raw == @output_specs_raw;

# Parse spec: file.rrd:field
sub parse_spec {
    my ($spec) = @_;
    my ($file, $field) = split(/:/, $spec, 2);
    $file = File::Spec->catfile($dbdir, $file) unless File::Spec->file_name_is_absolute($file);
    return ($file, $field);
}

# Get RRD info
sub get_rrd_info {
    my ($file) = @_;
    my $info = RRDs::info($file);
    if (my $err = RRDs::error) {
        die "Error reading $file: $err\n";
    }
    return $info;
}

# Get DS names
sub get_ds_names {
    my ($file) = @_;
    my $info = get_rrd_info($file);
    my @ds;
    for my $key (sort keys %$info) {
        push @ds, $1 if $key =~ /^ds\[([^\]]+)\]\.type$/;
    }
    return @ds;
}

# Get RRA as hash for comparison
sub get_rra_hash {
    my ($file) = @_;
    my $info = get_rrd_info($file);
    my %rras;
    for my $key (keys %$info) {
        if ($key =~ /^rra\[(\d+)\]\.(cf|xff|rows|pdp_per_row)$/) {
            $rras{$1}{$2} = $info->{$key};
        }
    }
    return \%rras;
}

# Compare RRAs
sub rras_match {
    my ($rra1, $rra2) = @_;

    my @keys1 = sort { $a <=> $b } keys %$rra1;
    my @keys2 = sort { $a <=> $b } keys %$rra2;

    return 0 unless @keys1 == @keys2;

    for my $i (0..$#keys1) {
        my $k1 = $keys1[$i];
        my $k2 = $keys2[$i];

        return 0 unless $rra1->{$k1}{cf} eq $rra2->{$k2}{cf};
        return 0 unless $rra1->{$k1}{rows} == $rra2->{$k2}{rows};
        return 0 unless $rra1->{$k1}{pdp_per_row} == $rra2->{$k2}{pdp_per_row};
    }

    return 1;
}

# Build mappings
my @mappings;
for my $i (0..$#input_specs_raw) {
    my ($in_file, $in_field) = parse_spec($input_specs_raw[$i]);
    my ($out_file, $out_field) = parse_spec($output_specs_raw[$i]);

    die "Error: Input file does not exist: $in_file\n" unless -f $in_file;

    die "Error: No DS name for input $in_file\n" unless defined $in_field;
    die "Error: No DS name for output $out_file\n" unless defined $out_field;

    # Get DS type for proper handling of DERIVE/COUNTER
    my $info = get_rrd_info($in_file);
    my $ds_type = $info->{"ds[$in_field].type"} || 'GAUGE';

    push @mappings, {
        in_file => $in_file,
        in_field => $in_field,
        out_file => $out_file,
        out_field => $out_field,
        ds_type => $ds_type,
    };
}

# Validate based on mode
if ($merge) {
    my %out_files = map { $_->{out_file} => 1 } @mappings;
    die "Error: --merge requires all outputs to same file\n" unless keys %out_files == 1;

    # Check all inputs are single-DS
    for my $m (@mappings) {
        my @ds = get_ds_names($m->{in_file});
        die "Error: Input $m->{in_file} has " . scalar(@ds) . " DS, expected 1\n" unless @ds == 1;
    }

    # Check RRAs are compatible
    my $first_rra = get_rra_hash($mappings[0]{in_file});
    for my $m (@mappings[1..$#mappings]) {
        my $rra = get_rra_hash($m->{in_file});
        unless (rras_match($first_rra, $rra)) {
            die "Error: RRA mismatch between $mappings[0]{in_file} and $m->{in_file}\n";
        }
    }

} elsif ($split) {
    my %in_files = map { $_->{in_file} => 1 } @mappings;
    die "Error: --split requires all inputs from same file\n" unless keys %in_files == 1;

    # Check input has all specified DS
    my @ds = get_ds_names($mappings[0]{in_file});
    my %ds_map = map { $_ => 1 } @ds;
    for my $m (@mappings) {
        die "Error: DS '$m->{in_field}' not found in $m->{in_file}\n"
            unless $ds_map{$m->{in_field}};
    }
}

# Print plan
print "Mode: " . ($merge ? "merge" : "split") . "\n";
print "Mappings:\n";
for my $m (@mappings) {
    print "  $m->{in_file}:$m->{in_field} -> $m->{out_file}:$m->{out_field}\n";
}

if ($dry_run) {
    print "\nDry run - no changes made\n";
    exit 0;
}

# Execute
if ($merge) {
    do_merge();
} else {
    do_split();
}

print "Done.\n";

sub do_merge {
    my $out_file = $mappings[0]->{out_file};

    print "\nMerging to $out_file...\n" if $verbose;

    my $tmpdir = tempdir(CLEANUP => 1);

    # Step 1: Extract each DS to a temporary single-DS RRD
    my @temp_files;
    for my $m (@mappings) {
        my $temp_file = "$tmpdir/" . basename($m->{in_file});

        # Dump to XML
        my $xml_file = "$temp_file.xml";
        RRDs::dump($m->{in_file}, $xml_file);
        if (my $err = RRDs::error) {
            die "RRDs::dump failed for $m->{in_file}: $err\n";
        }

        # Modify XML to rename DS
        open(my $fh, '<', $xml_file) or die "Cannot open $xml_file: $!\n";
        my $xml = do { local $/; <$fh> };
        close($fh);

        # Rename DS from input name to output name (handle whitespace)
        my $in_field = quotemeta($m->{in_field});
        my $out_field = $m->{out_field};
        $xml =~ s/<name>\s*$in_field\s*<\/name>/<name>$out_field<\/name>/g;

        open($fh, '>', $xml_file) or die "Cannot write $xml_file: $!\n";
        print $fh $xml;
        close($fh);

        # Restore to temp RRD
        RRDs::restore($xml_file, $temp_file);
        if (my $err = RRDs::error) {
            die "RRDs::restore failed: $err\n";
        }

        push @temp_files, $temp_file;
        print "  Extracted $m->{in_field} to temp file\n" if $verbose;
    }

    # Step 2: Merge all temp files into output using rrdxport
    # First, get the RRA structure from first input
    my $first_info = get_rrd_info($mappings[0]{in_file});
    my $step = $first_info->{step} || 300;
    # Use first non-temp file for start time - limit to 1 day to avoid step scaling
    my $start = RRDs::last($mappings[0]{in_file}) - (1 * 24 * 3600); # 30 days back

    # Build DEF/XPORT args for all DS
    my @xport_args = (
        '--start', $start,
        '--end', 'now',
        '--step', $step,
    );

    my @ds_names;
    for my $i (0..$#mappings) {
        my $m = $mappings[$i];
        my $temp_file = $temp_files[$i];
        my $out_field = $m->{out_field};

        push @xport_args, "DEF:ds_$i=$temp_file:$out_field:AVERAGE";
        push @xport_args, "XPORT:ds_$i";
        push @ds_names, $out_field;
    }

    # Export all data
    my ($x_start, $x_end, $x_step, $x_nb, $x_cols, $x_values) = RRDs::xport(@xport_args);
    if (my $err = RRDs::error) {
        die "RRDs::xport failed: $err\n";
    }

    # Step 3: Create output RRD
    my @ds_defs;
    for my $m (@mappings) {
        my $info = get_rrd_info($m->{in_file});
        my $ds_type = $info->{"ds[$m->{in_field}].type"} || 'GAUGE';
        my $heartbeat = $info->{"ds[$m->{in_field}].minimal_heartbeat"} || 600;
        my $min = $info->{"ds[$m->{in_field}].min"} || 'U';
        my $max = $info->{"ds[$m->{in_field}].max"} || 'U';

        push @ds_defs, "DS:$m->{out_field}:$ds_type:$heartbeat:$min:$max";
    }

    # Get RRAs from first input
    my @rra_args;
    for my $key (sort keys %$first_info) {
        if ($key =~ /^rra\[(\d+)\]\.(cf|xff|rows|pdp_per_row)$/) {
            my ($idx, $attr) = ($1, $2);
            $rra_args[$idx] //= {};
            $rra_args[$idx]{$attr} = $first_info->{$key};
        }
    }

    my @rra_cmd;
    for my $rra (@rra_args) {
        next unless $rra;
        push @rra_cmd, sprintf("RRA:%s:%s:%d:%d",
            $rra->{cf}, $rra->{xff}, $rra->{pdp_per_row}, $rra->{rows});
    }

    make_path(dirname($out_file), { mode => 0755 }) unless -d dirname($out_file);

    RRDs::create($out_file,
        '--start', $x_start - $x_step,
        '-s', $x_step,
        @ds_defs,
        @rra_cmd,
    );

    if (my $err = RRDs::error) {
        die "RRDs::create failed: $err\n";
    }

    print "  Created $out_file\n" if $verbose;

    # Step 4: Update output with exported data
    my $update_count = 0;
    for my $i (0..$#$x_values) {
        my $when = $x_start + ($i * $x_step);
        my @vals;
        for my $j (0..$#{$x_values->[$i]}) {
            my $val = $x_values->[$i][$j];
            if (!defined $val || $val eq 'nan') {
                push @vals, 'U';
            } else {
                # DERIVE/COUNTER need integers
                my $ds_type = $mappings[$j]{ds_type} || 'GAUGE';
                if ($ds_type eq 'DERIVE' || $ds_type eq 'COUNTER') {
                    push @vals, int($val + 0.5);
                } else {
                    push @vals, $val;
                }
            }
        }

        RRDs::update($out_file, "$when:" . join(':', @vals));
        if (my $err = RRDs::error) {
            die "RRDs::update failed: $err\n";
        }
        $update_count++;
    }

    print "  Wrote $update_count updates\n" if $verbose;

    # Step 5: Remove input files
    for my $m (@mappings) {
        unlink $m->{in_file} or die "Cannot remove $m->{in_file}: $!\n";
        print "  Removed $m->{in_file}\n" if $verbose;
    }
}

sub do_split {
    my $in_file = $mappings[0]->{in_file};

    print "\nSplitting $in_file...\n" if $verbose;

    my $tmpdir = tempdir(CLEANUP => 1);

    # Step 1: Dump input to XML
    my $xml_file = "$tmpdir/source.xml";
    RRDs::dump($in_file, $xml_file);
    if (my $err = RRDs::error) {
        die "RRDs::dump failed: $err\n";
    }

    # Read XML
    open(my $fh, '<', $xml_file) or die "Cannot open $xml_file: $!\n";
    my $xml = do { local $/; <$fh> };
    close($fh);

    # Step 2: For each output, create XML with single DS and restore
    my $info = get_rrd_info($in_file);
    my $step = $info->{step} || 300;
    my $start = RRDs::last($in_file) - (1 * 24 * 3600);

    for my $m (@mappings) {
        # Export just this DS
        my ($x_start, $x_end, $x_step, $x_nb, $x_cols, $x_values) = RRDs::xport(
            '--start', $start,
            '--end', 'now',
            '--step', $step,
            "DEF:val=$in_file:$m->{in_field}:AVERAGE",
            "XPORT:val",
        );

        if (my $err = RRDs::error) {
            die "RRDs::xport failed: $err\n";
        }

        # Create single-DS RRD
        my $ds_type = $info->{"ds[$m->{in_field}].type"} || 'GAUGE';
        my $heartbeat = $info->{"ds[$m->{in_field}].minimal_heartbeat"} || 600;
        my $min = $info->{"ds[$m->{in_field}].min"} || 'U';
        my $max = $info->{"ds[$m->{in_field}].max"} || 'U';

        # Get RRAs
        my @rra_args;
        for my $key (sort keys %$info) {
            if ($key =~ /^rra\[(\d+)\]\.(cf|xff|rows|pdp_per_row)$/) {
                my ($idx, $attr) = ($1, $2);
                $rra_args[$idx] //= {};
                $rra_args[$idx]{$attr} = $info->{$key};
            }
        }

        my @rra_cmd;
        for my $rra (@rra_args) {
            next unless $rra;
            push @rra_cmd, sprintf("RRA:%s:%s:%d:%d",
                $rra->{cf}, $rra->{xff}, $rra->{pdp_per_row}, $rra->{rows});
        }

        make_path(dirname($m->{out_file}), { mode => 0755 }) unless -d dirname($m->{out_file});

        RRDs::create($m->{out_file},
            '--start', $x_start - $x_step,
            '-s', $x_step,
            "DS:$m->{out_field}:$ds_type:$heartbeat:$min:$max",
            @rra_cmd,
        );

        if (my $err = RRDs::error) {
            die "RRDs::create failed for $m->{out_file}: $err\n";
        }

        # Update with data
        my $update_count = 0;
        for my $i (0..$#$x_values) {
            my $when = $x_start + ($i * $x_step);
            my $val = $x_values->[$i][0];
            $val = 'U' if !defined $val || $val eq 'nan';

            RRDs::update($m->{out_file}, "$when:$val");
            if (my $err = RRDs::error) {
                die "RRDs::update failed: $err\n";
            }
            $update_count++;
        }

        print "  Created $m->{out_file} ($update_count values)\n" if $verbose;
    }

    # Remove input file
    unlink $in_file or die "Cannot remove $in_file: $!\n";
    print "  Removed $in_file\n" if $verbose;
}

__END__

