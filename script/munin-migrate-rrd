#!/usr/bin/perl

use strict;
use warnings;
use Getopt::Long;
use File::Spec;
use File::Basename qw(dirname basename);
use File::Path qw(make_path);
use File::Copy qw(copy move);
use File::Temp qw(tempdir);
use RRDs;
use Pod::Usage;

=head1 NAME

munin-migrate-rrd - Copy/split/merge RRD data sources

=head1 SYNOPSIS

munin-migrate-rrd [options] -i input:ds -o output:ds [...]

Options:
  --dbdir=PATH     Base directory for RRD files (default: /var/lib/munin)
  --append         Merge DS into existing output file
  --dry-run        Show what would be done
  --verbose        Show progress
  --help           Show help

=head1 DESCRIPTION

Copies data sources between RRD files. Each -i maps to a -o (1:1).
All inputs must share the same RRA structure when writing to same output.

=head1 EXAMPLES

  # Copy three DS into one multi-DS file
  munin-migrate-rrd \
    -i cpu-idle-g.rrd:42 -o cpu-g.rrd:idle-g \
    -i cpu-user-g.rrd:42 -o cpu-g.rrd:user-g

  # Comma syntax
  munin-migrate-rrd \
    -i cpu-idle-g.rrd:42,cpu-user-g.rrd:42 \
    -o cpu-g.rrd:idle-g,user-g

  # Append DS to existing file
  munin-migrate-rrd --append \
    -i cpu-steal-g.rrd:42 -o cpu-g.rrd:steal-g

  # Split multi-DS to single-DS
  munin-migrate-rrd \
    -i cpu-g.rrd:idle-g -o cpu-idle-g.rrd:42 \
    -i cpu-g.rrd:user-g -o cpu-user-g.rrd:42

=cut

my $dbdir = '/var/lib/munin';
my $append = 0;
my $dry_run = 0;
my $verbose = 0;
my $help = 0;
my @input_args;
my @output_args;

GetOptions(
    'dbdir=s'    => \$dbdir,
    'append'     => \$append,
    'dry-run'    => \$dry_run,
    'verbose'    => \$verbose,
    'help'       => \$help,
    'i=s'        => \@input_args,
    'o=s'        => \@output_args,
) or pod2usage(1);

pod2usage(0) if $help;

die "Error: No input files\n" unless @input_args;
die "Error: No output files\n" unless @output_args;

# Expand comma-separated specs
sub expand {
    my ($specs, $is_input) = @_;
    my @out;
    for my $s (@$specs) {
        if ($s =~ /,/) {
            my @parts = split(/,/, $s);
            if (!$is_input && @parts > 1 && $parts[0] =~ /^([^:]+):(.+)$/) {
                my $file = $1;
                for my $p (@parts) {
                    push @out, ($p =~ /:/) ? $p : "$file:$p";
                }
            } else {
                push @out, @parts;
            }
        } else {
            push @out, $s;
        }
    }
    return @out;
}

my @inputs  = expand(\@input_args, 1);
my @outputs = expand(\@output_args, 0);

die "Error: Input count (" . scalar(@inputs) . ") must equal output count (" . scalar(@outputs) . ")\n"
    unless @inputs == @outputs;

# Parse spec: file:ds
sub parse {
    my ($spec) = @_;
    my ($file, $ds) = split(/:/, $spec, 2);
    $file = File::Spec->catfile($dbdir, $file) unless File::Spec->file_name_is_absolute($file);
    return ($file, $ds);
}

# Get RRD info
sub rrd_info {
    my ($file) = @_;
    die "Error: File not found: $file\n" unless -f $file;
    my $info = RRDs::info($file);
    die "Error reading $file: " . RRDs::error . "\n" if RRDs::error;
    return $info;
}

# Get RRAs as sorted string for comparison
sub rra_key {
    my ($info) = @_;
    my @rras;
    for my $k (sort keys %$info) {
        if ($k =~ /^rra\[(\d+)\]\.(cf|xff|rows|pdp_per_row)$/) {
            $rras[$1]{$2} = $info->{$k};
        }
    }
    my $key = '';
    for my $r (@rras) {
        next unless $r;
        $key .= join(':', @{$r}{qw(cf pdp_per_row rows xff)}) . '|';
    }
    return $key;
}

# Build mappings
my @mappings;
for my $i (0..$#inputs) {
    my ($in_file, $in_ds) = parse($inputs[$i]);
    my ($out_file, $out_ds) = parse($outputs[$i]);

    die "Error: No DS name in '$inputs[$i]'\n" unless defined $in_ds;
    die "Error: No DS name in '$outputs[$i]'\n" unless defined $out_ds;
    die "Error: Input not found: $in_file\n" unless -f $in_file;

    my $info = rrd_info($in_file);

    # Verify input DS exists
    my $ds_type = $info->{"ds[$in_ds].type"};
    die "Error: DS '$in_ds' not found in $in_file\n" unless defined $ds_type;

    push @mappings, {
        in_file  => $in_file,
        in_ds    => $in_ds,
        out_file => $out_file,
        out_ds   => $out_ds,
        info     => $info,
    };
}

# Group by output file
my %by_output;
for my $m (@mappings) {
    push @{$by_output{$m->{out_file}}}, $m;
}

# Validate RRA compatibility for each output file
for my $out_file (keys %by_output) {
    my $group = $by_output{$out_file};
    my $first_key = rra_key($group->[0]{info});
    for my $m (@$group[1..$#$group]) {
        my $key = rra_key($m->{info});
        if ($key ne $first_key) {
            die "Error: RRA mismatch for $out_file\n" .
                "  $m->{in_file}:$m->{in_ds} has different RRAs\n";
        }
    }
}

# Print plan
print "Mappings:\n";
for my $m (@mappings) {
    print "  $m->{in_file}:$m->{in_ds} -> $m->{out_file}:$m->{out_ds}\n";
}

if ($dry_run) {
    print "\nDry run - no changes\n";
    exit 0;
}

# Execute
my %input_removed;
for my $out_file (sort keys %by_output) {
    my $group = $by_output{$out_file};
    copy_ds($out_file, $group, \%input_removed);
}

# Remove inputs
for my $m (@mappings) {
    next if $input_removed{$m->{in_file}};
    unlink $m->{in_file} or warn "Cannot remove $m->{in_file}: $!\n";
    print "  Removed $m->{in_file}\n" if $verbose;
    $input_removed{$m->{in_file}} = 1;
}

print "Done.\n";

sub copy_ds {
    my ($out_file, $group, $input_removed) = @_;

    my $first = $group->[0];
    my $first_info = $first->{info};
    my $step = $first_info->{step} || 300;
    my $start = RRDs::last($first->{in_file}) - (1 * 24 * 3600);

    # Build RRAs from first input
    my @rras;
    for my $k (sort keys %$first_info) {
        if ($k =~ /^rra\[(\d+)\]\.(cf|xff|rows|pdp_per_row)$/) {
            $rras[$1]{$2} = $first_info->{$k};
        }
    }

    my @rra_args;
    for my $r (@rras) {
        next unless $r;
        push @rra_args, sprintf("RRA:%s:%s:%d:%d",
            $r->{cf}, $r->{xff}, $r->{pdp_per_row}, $r->{rows});
    }

    # Build DS definitions from all inputs
    my @ds_defs;
    my @ds_order;  # output DS names in order
    for my $m (@$group) {
        my $info = $m->{info};
        my $ds = $m->{in_ds};

        push @ds_defs, sprintf("DS:%s:%s:%d:%s:%s",
            $m->{out_ds},
            $info->{"ds[$ds].type"},
            $info->{"ds[$ds].minimal_heartbeat"} || 600,
            $info->{"ds[$ds].min"} // 'U',
            $info->{"ds[$ds].max"} // 'U',
        );
        push @ds_order, $m->{out_ds};
    }

    my $tmpdir = tempdir(CLEANUP => 1);

    if (-f $out_file && $append) {
        # --append: merge existing + new DS
        do_append($out_file, $group, $tmpdir);
        return;
    }

    if (-f $out_file) {
        die "Error: Output exists: $out_file (use --append to merge)\n";
    }

    # Fetch all data via xport
    my @xport_args = ('--start', $start, '--end', 'now', '--step', $step);
    for my $i (0..$#$group) {
        my $m = $group->[$i];
        push @xport_args, "DEF:ds_$i=$m->{in_file}:$m->{in_ds}:AVERAGE";
        push @xport_args, "XPORT:ds_$i";
    }

    my ($x_start, $x_end, $x_step, $x_nb, $x_cols, $x_values) = RRDs::xport(@xport_args);
    die "RRDs::xport: " . RRDs::error . "\n" if RRDs::error;

    # Create output
    my $dir = dirname($out_file);
    make_path($dir, { mode => 0755 }) unless -d $dir;

    RRDs::create($out_file,
        '--start', $x_start - $x_step,
        '-s', $x_step,
        @ds_defs,
        @rra_args,
    );
    die "RRDs::create: " . RRDs::error . "\n" if RRDs::error;

    print "  Created $out_file\n" if $verbose;

    # Write data
    my $count = 0;
    my $num_ds = scalar @$group;
    for my $i (0..$#$x_values) {
        my $when = $x_start + ($i * $x_step);
        my @vals;
        for my $j (0..$num_ds-1) {
            my $val = $x_values->[$i][$j];
            push @vals, (defined $val && $val ne 'nan') ? $val : 'U';
        }
        RRDs::update($out_file, "$when:" . join(':', @vals));
        die "RRDs::update: " . RRDs::error . "\n" if RRDs::error;
        $count++;
    }

    print "  Wrote $count updates\n" if $verbose;
}

sub do_append {
    my ($out_file, $group, $tmpdir) = @_;

    print "  Appending to $out_file...\n" if $verbose;

    my $existing_info = rrd_info($out_file);
    my $existing_step = $existing_info->{step} || 300;
    my $existing_start = RRDs::last($out_file) - (1 * 24 * 3600);

    # Verify step matches
    my $new_step = $group->[0]{info}{step} || 300;
    die "Error: Step mismatch ($existing_step vs $new_step)\n"
        unless $existing_step == $new_step;

    # Verify RRAs match
    my $existing_rra = rra_key($existing_info);
    my $new_rra = rra_key($group->[0]{info});
    die "Error: RRA mismatch for append\n" unless $existing_rra eq $new_rra;

    # Check no DS name collision
    my %existing_ds;
    for my $k (keys %$existing_info) {
        $existing_ds{$1} = 1 if $k =~ /^ds\[([^\]]+)\]\.type$/;
    }
    for my $m (@$group) {
        die "Error: DS '$m->{out_ds}' already exists in $out_file\n"
            if $existing_ds{$m->{out_ds}};
    }

    # Export existing data
    my @existing_ds_names;
    for my $k (sort keys %$existing_info) {
        push @existing_ds_names, $1 if $k =~ /^ds\[([^\]]+)\]\.type$/;
    }

    my @xport_args = ('--start', $existing_start, '--end', 'now', '--step', $existing_step);
    my $idx = 0;

    # Existing DS
    for my $ds (@existing_ds_names) {
        push @xport_args, "DEF:e_$idx=$out_file:$ds:AVERAGE";
        push @xport_args, "XPORT:e_$idx";
        $idx++;
    }

    # New DS
    my @new_ds_names;
    for my $m (@$group) {
        push @new_ds_names, $m->{out_ds};
        push @xport_args, "DEF:n_" . ($idx - scalar(@existing_ds_names)) . "=$m->{in_file}:$m->{in_ds}:AVERAGE";
        push @xport_args, "XPORT:n_" . ($idx - scalar(@existing_ds_names));
        $idx++;
    }

    my ($x_start, $x_end, $x_step, $x_nb, $x_cols, $x_values) = RRDs::xport(@xport_args);
    die "RRDs::xport: " . RRDs::error . "\n" if RRDs::error;

    # Build merged DS definitions
    my @ds_defs;

    # Existing DS
    for my $ds (@existing_ds_names) {
        push @ds_defs, sprintf("DS:%s:%s:%d:%s:%s",
            $ds,
            $existing_info->{"ds[$ds].type"},
            $existing_info->{"ds[$ds].minimal_heartbeat"} || 600,
            $existing_info->{"ds[$ds].min"} // 'U',
            $existing_info->{"ds[$ds].max"} // 'U',
        );
    }

    # New DS
    for my $m (@$group) {
        my $info = $m->{info};
        my $ds = $m->{in_ds};
        push @ds_defs, sprintf("DS:%s:%s:%d:%s:%s",
            $m->{out_ds},
            $info->{"ds[$ds].type"},
            $info->{"ds[$ds].minimal_heartbeat"} || 600,
            $info->{"ds[$ds].min"} // 'U',
            $info->{"ds[$ds].max"} // 'U',
        );
    }

    # Build RRAs
    my @rras;
    for my $k (sort keys %$existing_info) {
        if ($k =~ /^rra\[(\d+)\]\.(cf|xff|rows|pdp_per_row)$/) {
            $rras[$1]{$2} = $existing_info->{$k};
        }
    }
    my @rra_args;
    for my $r (@rras) {
        next unless $r;
        push @rra_args, sprintf("RRA:%s:%s:%d:%d",
            $r->{cf}, $r->{xff}, $r->{pdp_per_row}, $r->{rows});
    }

    # Create temp file
    my $tmp_file = "$tmpdir/merged.rrd";
    RRDs::create($tmp_file,
        '--start', $x_start - $x_step,
        '-s', $x_step,
        @ds_defs,
        @rra_args,
    );
    die "RRDs::create: " . RRDs::error . "\n" if RRDs::error;

    # Write data
    my $count = 0;
    my $num_ds = scalar(@$group) + scalar(@existing_ds_names);
    for my $i (0..$#$x_values) {
        my $when = $x_start + ($i * $x_step);
        my @vals;
        for my $j (0..$num_ds-1) {
            my $val = $x_values->[$i][$j];
            push @vals, (defined $val && $val ne 'nan') ? $val : 'U';
        }
        RRDs::update($tmp_file, "$when:" . join(':', @vals));
        die "RRDs::update: " . RRDs::error . "\n" if RRDs::error;
        $count++;
    }

    print "  Wrote $count updates to temp file\n" if $verbose;

    # Swap files: old -> .bak, tmp -> old
    my $bak_file = "$out_file.bak";
    move($out_file, $bak_file) or die "Cannot rename $out_file -> $bak_file: $!\n";
    move($tmp_file, $out_file) or die "Cannot rename $tmp_file -> $out_file: $!\n";

    print "  Renamed $out_file -> $bak_file\n" if $verbose;
    print "  Appended " . scalar(@$group) . " DS to $out_file\n" if $verbose;
}

__END__

